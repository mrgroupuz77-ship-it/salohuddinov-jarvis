{
  "name": "salohuddinov-jarvis",
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/eve/bin/eve.js dev",
    "build": "node --env-file-if-exists=.env node_modules/eve/bin/eve.js build",
    "start": "node --env-file-if-exists=.env node_modules/eve/bin/eve.js start",
    "typecheck": "tsc",
    "test": "node --test --test-reporter=spec \"tests/unit/*.test.ts\"",
    "build:test": "MODEL_ID=claude-test-model eve build",
    "test:e2e": "node tests/e2e/run-e2e.ts",
    "test:e2e:schedule": "node tests/e2e/run-e2e-schedule.ts",
    "check-env": "node --env-file-if-exists=.env scripts/check-env.ts",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "webhook:set": "node --env-file-if-exists=.env scripts/set-webhook.ts",
    "deploy": "eve deploy"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@vercel/connect": "2.2.0",
    "ai": "^7.0.137",
    "eve": "^0.77.0",
    "just-bash": "^3.6.0",
    "pg": "^8.23.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "@types/pg": "^8.23.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "24.x"
  },
  "description": "Salohuddinov Jarvis — Telegram orqali ishlaydigan shaxsiy ish yordamchisi (eve + Claude)"
}
