[Unit]
Description=Salohuddinov Jarvis (eve agent, Telegram)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=jarvis
WorkingDirectory=/home/jarvis/salohuddinov-jarvis
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/npm start -- --port 3000 --host 127.0.0.1
Restart=always
RestartSec=5
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/jarvis/salohuddinov-jarvis

[Install]
WantedBy=multi-user.target
