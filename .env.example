# Salohuddinov Jarvis — server sozlamalari (faqat placeholder).
# Haqiqiy qiymatlarni shu faylga emas, hosting “Environment variables / Secrets”
# bo‘limiga yoki serverdagi .env fayliga yozing. .env git’ga kirmaydi.

# ── Telegram (1–2-bosqich, majburiy) ─────────────────────────────
# BotFather’da /revoke qilib olingan YANGI token. Chatga yozmang.
TELEGRAM_BOT_TOKEN=<secret orqali>
# Ixtiyoriy. Bo‘sh bo‘lsa, bot tokenidan avtomatik hosil qilinadi.
TELEGRAM_WEBHOOK_SECRET_TOKEN=
# Serverning ochiq HTTPS manzili. Vercel va Railway’da shart emas (production domeni avtomatik olinadi).
PUBLIC_URL=
# Sizning Telegram user ID’ingiz (raqam). Bilmasangiz: botga /start yozing — bot ko‘rsatadi.
TELEGRAM_OWNER_USER_ID=<tekshirilgan egasi>
# Bot username, @ belgisisiz (ixtiyoriy)
TELEGRAM_BOT_USERNAME=
# Guruhlarda ishlash (boshlang‘ich: o‘chirilgan)
TELEGRAM_ALLOW_GROUPS=false
# Tasdiq bilan post qilish mumkin bo‘lgan kanal/guruhlar (vergul bilan). Bot u yerda admin bo‘lishi kerak.
TELEGRAM_PUBLISH_CHAT_IDS=

# ── Vaqt ─────────────────────────────────────────────────────────
APP_TIMEZONE=Asia/Tashkent

# ── Ma’lumotlar bazasi ───────────────────────────────────────────
# Vercel: Neon integratsiyasi DATABASE_URL (yoki POSTGRES_URL) ni o‘zi qo‘shadi.
# Railway (Dockerfile): pglite:/data/jarvis — avtomatik, /data volume kerak.
# PostgreSQL: postgres://user:password@host:5432/jarvis?sslmode=require
# Lokal: pglite:./data/jarvis
DATABASE_URL=pglite:./data/jarvis
# O‘z serveringizdagi PostgreSQL self-signed sertifikat bilan bo‘lsa (Neon uchun kerak emas)
DATABASE_SSL_INSECURE=false

# ── Model ────────────────────────────────────────────────────────
# Provayder MODEL_ID dan aniqlanadi (agent/lib/model-config.ts):
#   gemini-…  → Google AI Studio, bepul tarif bor  (kalit: GEMINI_API_KEY)
#   claude-…  → Anthropic API, pullik              (kalit: ANTHROPIC_API_KEY)
#   vendor/…  → Vercel AI Gateway
MODEL_ID=gemini-3.8-flash
# Majburlash kerak bo‘lsa: google | anthropic | gateway
MODEL_PROVIDER=
# Google AI Studio kaliti (GOOGLE_GENERATIVE_AI_API_KEY nomi ham ishlaydi)
GEMINI_API_KEY=<secret orqali>
# Claude ishlatilsa
ANTHROPIC_API_KEY=
# Xarajat chegarasi: bitta sessiya shu tokenlarga yetganda Telegramda ruxsat so‘raladi
SESSION_MAX_INPUT_TOKENS=3000000
SESSION_MAX_OUTPUT_TOKENS=200000
MODEL_CONTEXT_WINDOW_TOKENS=200000

# ── eve operator API (ixtiyoriy) ─────────────────────────────────
# /eve/v1/* ni Basic auth bilan ochish (TUI orqali ulanish uchun). Bo‘sh bo‘lsa yopiq.
EVE_ADMIN_USER=
EVE_ADMIN_PASSWORD=
EVE_TELEMETRY_DISABLED=1

# ── Ovozli xabarlar → matn (5-bosqich, ixtiyoriy) ────────────────
# OpenAI-compatible /audio/transcriptions endpoint. O‘zbekcha sifatini sinab ko‘ring.
STT_PROVIDER=none
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=
STT_API_KEY=
STT_LANGUAGE=uz
STT_MAX_SECONDS=300

# ── Telefon qo‘ng‘irog‘i (5-bosqich) ─────────────────────────────
CALLS_ENABLED=false
# Faqat shu raqamga (E.164, masalan +998901234567)
CALLS_ALLOWED_NUMBER=
